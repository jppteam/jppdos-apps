# Custom server profile for the MTProto client.
#
# Copy to /sd/apps/mtproto-client/custom.conf — over the device's WebDAV server
# (Settings > WebDAV server), or by putting the SD card in a reader — and the
# "Custom" entry in the server picker becomes selectable.
#
# Anything wrong here is reported by name on the picker screen rather than as a
# failed connection, so a typo tells you which line to fix.

# Where to connect. A hostname or a dotted quad; the firmware resolves either.
dc_host = 149.154.167.51
dc_port = 443

# The datacentre number this endpoint answers as. It has to match what the
# server believes, because the handshake sends it inside p_q_inner_data_dc and a
# mismatch is rejected.
dc_id = 2

# The server's RSA public modulus, hex, 512 characters for a 2048-bit key.
# Whitespace and colons are ignored, so a wrapped or colon-separated dump pastes
# in as-is. To extract it from a PEM public key:
#
#   openssl rsa -pubin -in server.pem -RSAPublicKey_out -text -noout
#
# and concatenate the bytes printed under "Modulus:".
rsa_modulus = C150023E2F70DB7985DED064759CFECF0AF328E69A41DAF4D6F01B538135A6F9
              1F8F8B2A0EC9BA9720CE352EFCF6C5680FFC424BD634864902DE0B4BD6D49F4E
              580230E3AE97D95C8B19442B3C0A10D8F5633FECEDD6926A7F6DAB0DDB7D457F
              9EA81B8465FCD6FFFEED114011DF91C059CAEDAF97625F6C96ECC74725556934
              EF781D866B34F011FCE4D835A090196E9A5F0E4449AF7EB697DDB9076494CA5F
              81104A305B6DD27665722C46B60E5DF680FB16B210607EF217652E60236C255F
              6A28315F4083A96791D7214BF64C1DF4FD0DB1944FB26A2A57031B32EEE64AD1
              5A8BA68885CDE74A5BFC920F6ABF59BA5C75506373E7130F9042DA922179251F

# The exponent, hex. 010001 is 65537, which is what essentially every RSA key
# uses; change it only if the server's key genuinely differs.
rsa_exponent = 010001

# Application credentials. A self-hosted server that does not check them will
# accept any nonzero api_id and a 32-character hash.
api_id   = 0
api_hash = 0123456789abcdef0123456789abcdef
